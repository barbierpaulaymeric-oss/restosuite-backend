<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		v1 App Store : pas de capability push (réseau-seule). Pour réactiver en
		v1.x, remettre l'APNs production :
		<key>aps-environment</key><string>production</string>
		(api.push.apple.com, imposé par Apple pour les profils de distribution).
	-->
</dict>
</plist>
