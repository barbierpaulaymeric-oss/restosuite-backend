<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Push Notifications — production APNs (api.push.apple.com). Utilisé en
		build Release (TestFlight + App Store). Apple impose ce serveur pour les
		apps signées avec un profil distribution.
	-->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
